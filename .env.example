# Discord OAuth2 (https://discord.com/developers/applications -> ton app -> OAuth2 -> General)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Discord ID(s) qui ont accès au panneau admin (séparés par des virgules si plusieurs)
ADMIN_DISCORD_IDS=1534876283421462549

# Supabase (Project Settings -> API). SUPABASE_SERVICE_ROLE_KEY reste secrète :
# elle n'est utilisée QUE côté serveur, jamais envoyée au navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Session
SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

PORT=3000
